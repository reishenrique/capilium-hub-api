# PORT CONFIG
ENV=3000

# DATABASE CONNECTIONS
DATABASE_URL=''

# POOLSIZE MONGODB CONFIGS
MAX_POOL_SIZE_MONGO=50
MIN_POOL_SIZE_MONGO=5
RATE_LIMIT_TIME=10000
RATE_LIMIT_AMOUNT_REQUESTS=10

# JWT SECRET PROVIDER
SECRET=''

# REDIS CONFIGS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=YOURPASSWORD

# Mailer
MAIL_HOST="sandbox.smtp.mailtrap.io"
MAIL_PORT=2525
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM=""

# Cache strategy
CACHE_STRATEGY=nodeCache || redisCache